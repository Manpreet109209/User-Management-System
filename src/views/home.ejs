<link rel="stylesheet" href="/css/home.css" />

<div class="home-container">
  <div class="home-card">

    <!-- Title -->
    <h1 class="home-title">
      Meet the People Behind the Data
    </h1>

    <!-- Subtitle -->
    <p class="home-subtitle">
      Explore, create, and manage users with a clean and simple interface.
      Because chaos belongs in code, not in your UI.
    </p>

    <!-- Count Display -->
    <div class="user-count">
      <span>Total Users</span>
      <h2><%= count %></h2>
    </div>

    <!-- CTA Buttons -->
    <div class="home-actions">
      <a href="/user" class="btn-primary">
        View Users →
      </a>

      <a href="/user/new" class="btn-secondary">
        + Add New User
      </a>
    </div>

  </div>
</div>